{
  "name": "spueli99/open-phonebook",
  "description": "Self-hosted multi-user contact hub for IP phones, call events and notifications.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-xmlreader": "*",
    "ext-xmlwriter": "*",
    "giggsey/libphonenumber-for-php-lite": "^9.0.41",
    "guzzlehttp/guzzle": "^7.9",
    "minishlink/web-push": "^11.0",
    "sabre/vobject": "^5.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "autoload": {
    "psr-4": {
      "OpenPhonebook\\": "src/"
    },
    "classmap": [
      "database/migrations/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "OpenPhonebook\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "analyse": "phpstan analyse --memory-limit=512M",
    "test": "phpunit",
    "audit": "composer audit --locked --no-interaction",
    "check": [
      "@lint",
      "@analyse",
      "@test",
      "@audit"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "sort-packages": true
  }
}
